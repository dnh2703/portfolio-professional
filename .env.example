# Server-only settings for the assistant's /api/assistant route. Copy to .env.local and fill in.
# Never prefix these with NEXT_PUBLIC_: they must not reach the browser. Every one is optional.

# TypeSafe API key for Jev, which picks the topic of a typed question.
# Without it the route falls back to keyword matching.
TYPESAFE_API_KEY=

# Telegram alerts for unanswered questions. Create the bot with @BotFather, send it a message,
# then read your chat id from https://api.telegram.org/bot<token>/getUpdates.
# Without them no alerts are sent.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Upstash Redis REST credentials for the per-visitor rate limit and alert dedupe.
# Without them both are kept in memory, per server instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
